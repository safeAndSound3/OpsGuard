[Unit]
Description=OpsGuard host monitoring agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opsguard
Group=opsguard
ExecStart=/opt/opsguard-agent/opsguard-agent -config /etc/opsguard-agent/agent.conf
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=256M
CPUQuota=50%
TasksMax=128
KillMode=control-group
ReadWritePaths=/var/lib/opsguard-agent
ReadWritePaths=/var/log/opsguard-agent
ReadWritePaths=/etc/opsguard-agent

[Install]
WantedBy=multi-user.target
