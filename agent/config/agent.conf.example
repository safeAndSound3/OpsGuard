# 拉取式 Agent：平台在运行期间请求指标、文件检测和脚本检测。
# 监听地址。仅本机访问可填写 127.0.0.1:4001；由平台访问时使用实际网卡地址或 0.0.0.0:4001。
LISTEN=0.0.0.0:4001
# Agent 服务日志文件，建议生产环境使用 /var/log/opsguard-agent/agent.log。
LOG_FILE=/var/log/opsguard-agent/agent.log
# 平台访问 Agent 时使用的固定令牌。请为每台 Agent 生成不同的随机值。
TOKEN=replace-with-a-per-agent-random-token
# 允许请求 Agent 的平台 IP 或网段，多个值以英文逗号分隔。生产环境必须填写。
# 留空仅用于兼容已有部署，会允许所有来源访问。
ALLOWED_PLATFORM_IPS=10.0.0.10/32
# 单条脚本检测的最长执行时间，单位为秒，取值范围为 1 至 300。
COMMAND_TIMEOUT_SECONDS=30
# 单次文件或脚本检测可返回的最大输出字节数，取值范围为 1024 至 1048576。
MAX_OUTPUT_BYTES=65536
